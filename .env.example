# Copy this file to .env and add a Hugging Face token after accepting:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Local summaries run on Windows beside the existing Ollama service.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODELS=gemma4:e4b,gemma4:26b

# Used only when LLM_PROVIDER=openai (for example, a local vLLM server).
LLM_API_KEY=

# Kept in the Windows user environment on this machine; do not copy its value here.
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
